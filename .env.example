# Copy to .env.local for local dev, and set the same keys in
# Netlify → Site configuration → Environment variables for production.
#
# Without these three, /api/contact still accepts and validates submissions —
# it just logs them to the server console instead of emailing. The form tells
# the visitor to use WhatsApp in that case, so nothing silently disappears.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
